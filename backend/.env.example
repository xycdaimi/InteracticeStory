# —— GeekAI（文本 / 图像 / 向量）——
GEEKAI_API_KEY=
GEEKAI_BASE_URL=https://geekai.co/api/v1

# 裂变 / 合规 / 抽卡 / MiniMax 提示词（文本）
CHAT_MODEL=gpt-5.4-mini
COMPLIANCE_MODEL=gpt-5.4-mini
PROMPT_MODEL=gpt-5.4-mini

# 静态素材：人物图、场景图
IMAGE_CHARACTER_MODEL=gpt-image-2
IMAGE_SCENE_MODEL=nano-banana-2-lite
IMAGE_SCENE_SIZE=1K

# 生产期 RAG（本阶段可先占位，出片后再用）
EMBEDDING_MODEL=text-embedding-3-small

# —— Exa 检索（裂变收集）——
EXA_API_KEY=
EXA_BASE_URL=https://api.exa.ai

# —— ephone / MiniMax（流程视频 §2 出片与重生；§1 只写提示词也可先填好）——
EPHONE_API_KEY=
EPHONE_BASE_URL=https://api.ephone.ai
VIDEO_MODEL=MiniMax-H3
VIDEO_REGEN_MODEL=MiniMax-H3/regeneration
VIDEO_DEFAULT_RATIO=16:9
VIDEO_RESOLUTION=768P

# —— 千问 Omni（视频质检，流程 §2）——
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VIDEO_QC_MODEL=qwen3-omni-flash

IMAGE_MAX_CONCURRENCY=4
VIDEO_MAX_CONCURRENCY=2
VIDEO_POLL_INTERVAL=3.0
VIDEO_REGEN_MAX=2

# 预生产片段占比（主线+易达剧情线）；其余游玩时按需生成
PREFETCH_SEGMENT_RATIO=0.8

# —— 运行 ——
DATA_DIR=./data
# 最少完整剧情线数（consistency 校验）
MIN_STORY_LINES=8
# 剧情树：单节点最大子分支数（每个分叉点最多几条出路，2–3 常见）
FISSION_BRANCH_DEPTH=3
